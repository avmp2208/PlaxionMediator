      "name": "Configure Order Failure (enable rollback demo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('FailNext is true', () => pm.expect(pm.response.json().failNext).to.eql(true));"
            ],
