          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"failNext\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/demo/orders/configure-failure",
          "host": ["{{baseUrl}}"],
          "path": ["demo", "orders", "configure-failure"]
        },
        "description": "Arms the OrderFailureSimulator so the next Create Order call throws after SaveChanges and TransactionBehavior rolls back."
      }
    },
    {
      "name": "Create Order (Handler Failure -> Rollback)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// FailNext is consumed (reset to false) by the very first CreateOrder call after it is armed,",
              "// so this request self-arms every time it runs. Without this, re-running ONLY this request",
              "// (without re-running 'Configure Order Failure' first) would hit the handler with FailNext",
              "// already false, the order would be created successfully (200), and the test below would fail.",
              "pm.sendRequest({",
              "    url: pm.variables.replaceIn('{{baseUrl}}/demo/orders/configure-failure'),",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify({ failNext: true }) }",
              "}, (err, res) => {",
              "    if (err) { console.error('Failed to arm OrderFailureSimulator:', err); }",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is not 200 (handler failed)', () => pm.expect(pm.response.code).to.not.eql(200));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"cust-rollback\",\n  \"total\": 1.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Self-arms OrderFailureSimulator via a prerequest script (calling /demo/orders/configure-failure), then creates the order; the handler throws after SaveChanges and TransactionBehavior rolls back so 'cust-rollback' is not persisted. Safe to re-run this single request repeatedly - it no longer depends on 'Configure Order Failure' having been run immediately before it. Follow with List Orders to verify."
      }
    },
