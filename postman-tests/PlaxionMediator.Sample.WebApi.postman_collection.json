    {
      "name": "Circuit Breaker Recovers (Half-Open Probe Succeeds)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// The sample's BreakDuration is 500ms. When running the whole collection via the Collection",
              "// Runner (or 'Run all tests'), the preceding requests execute back-to-back with no real delay,",
              "// so the circuit can still be Open by the time this request fires - causing a flaky/failing",
              "// first run that only passes on 'Run Again' once enough wall-clock time has incidentally",
              "// passed. Block synchronously for longer than BreakDuration so the probe is always half-open.",
              "const start = Date.now();",
              "while (Date.now() - start < 750) { /* busy-wait */ }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Response has payload and attempts', () => {",
              "    pm.expect(body).to.have.property('payload', 'recovered');",
              "    pm.expect(body).to.have.property('attempts');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payload\": \"recovered\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/demo/circuit-breaker",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "demo",
            "circuit-breaker"
          ]
        },
        "description": "Run this after 'Configure Circuit Breaker Demo (Recover)': a pre-request script blocks for 750ms (past the sample's 500ms BreakDuration) so the half-open probe reliably succeeds and the circuit closes again, even when running the whole collection back-to-back via the Collection Runner."
      }
    },
