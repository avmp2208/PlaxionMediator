<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Conduit.DependencyInjection</RootNamespace>
    <AssemblyName>Conduit.DependencyInjection</AssemblyName>
    <PackageId>Conduit.DependencyInjection</PackageId>
    <Description>Dependency injection extensions (AddConduit) for the Conduit request pipeline framework.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit.Abstractions\Conduit.Abstractions.csproj" />
    <ProjectReference Include="..\Conduit.Core\Conduit.Core.csproj" />
    <ProjectReference Include="..\Conduit.Pipeline\Conduit.Pipeline.csproj" />
  </ItemGroup>

  <!-- Ensure analyzer/generator DLLs are packed under analyzers/dotnet/cs when packing this package -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTransitiveAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="PackTransitiveAnalyzers" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)Conduit.SourceGenerators.dll"
                              Condition="Exists('$(OutputPath)Conduit.SourceGenerators.dll')"
                              PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)Conduit.Analyzers.dll"
                              Condition="Exists('$(OutputPath)Conduit.Analyzers.dll')"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
