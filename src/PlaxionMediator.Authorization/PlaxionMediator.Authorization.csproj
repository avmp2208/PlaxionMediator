<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>PlaxionMediator.Authorization</RootNamespace>
    <AssemblyName>PlaxionMediator.Authorization</AssemblyName>
    <PackageId>PlaxionMediator.Authorization</PackageId>
    <Description>Transport-neutral, request-level authorization pipeline behavior for PlaxionMediator.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Version>1.0.0</Version>
    <PackageIcon>plaxionlogonuget.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\plaxionlogonuget.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaxionMediator.Abstractions\PlaxionMediator.Abstractions.csproj" />
    <ProjectReference Include="..\PlaxionMediator\PlaxionMediator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PlaxionMediator.Authorization.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
