<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PlaxionMediator.DependencyInjection</RootNamespace>
    <AssemblyName>PlaxionMediator.DependencyInjection</AssemblyName>
    <PackageId>PlaxionMediator.DependencyInjection</PackageId>
    <Description>Dependency injection extensions (AddPlaxionMediator) for the PlaxionMediator request pipeline framework.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaxionMediator.Abstractions\PlaxionMediator.Abstractions.csproj" />
    <ProjectReference Include="..\PlaxionMediator.Core\PlaxionMediator.Core.csproj" />
    <ProjectReference Include="..\PlaxionMediator.Pipeline\PlaxionMediator.Pipeline.csproj" />
    <ProjectReference Include="..\PlaxionMediator.SourceGenerators\PlaxionMediator.SourceGenerators.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PlaxionMediator.Analyzers\PlaxionMediator.Analyzers.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ensure analyzer/generator DLLs are packed under analyzers/dotnet/cs when packing this package -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTransitiveAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="PackTransitiveAnalyzers" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_ResolvedProjectReferencePaths)" 
                              Condition="'%(_ResolvedProjectReferencePaths.Filename)' == 'PlaxionMediator.SourceGenerators' or '%(_ResolvedProjectReferencePaths.Filename)' == 'PlaxionMediator.Analyzers'"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
