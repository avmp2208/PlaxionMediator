<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>PlaxionMediator.Retry</RootNamespace>
    <AssemblyName>PlaxionMediator.Retry</AssemblyName>
    <PackageId>PlaxionMediator.Retry</PackageId>
    <Description>Transient-fault retry pipeline behavior with exponential backoff for PlaxionMediator.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Version>0.7.1</Version>
    <PackageIcon>plaxionlogonuget.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\plaxionlogonuget.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaxionMediator.Abstractions\PlaxionMediator.Abstractions.csproj" />
    <ProjectReference Include="..\PlaxionMediator\PlaxionMediator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PlaxionMediator.Retry.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PlaxionMediator.Transactions.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
