<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>PlaxionMediator.Testing</RootNamespace>
    <AssemblyName>PlaxionMediator.Testing</AssemblyName>
    <PackageId>PlaxionMediator.Testing</PackageId>
    <Description>Test doubles and helpers for PlaxionMediator (FakeSender, etc.).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Version>1.0.0</Version>
    <PackageIcon>plaxionlogonuget.png</PackageIcon>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\plaxionlogonuget.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaxionMediator.Core\PlaxionMediator.Core.csproj" />
    <ProjectReference Include="..\PlaxionMediator.SourceGenerators\PlaxionMediator.SourceGenerators.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PlaxionMediator.Analyzers\PlaxionMediator.Analyzers.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ensure analyzer/generator DLLs are packed under analyzers/dotnet/cs when packing this package -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTransitiveAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="PackTransitiveAnalyzers" DependsOnTargets="ResolveProjectReferences" Condition="'$(TargetFramework)' == 'net9.0'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_ResolvedProjectReferencePaths)" 
                              Condition="'%(_ResolvedProjectReferencePaths.Filename)' == 'PlaxionMediator.SourceGenerators' or '%(_ResolvedProjectReferencePaths.Filename)' == 'PlaxionMediator.Analyzers'"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
