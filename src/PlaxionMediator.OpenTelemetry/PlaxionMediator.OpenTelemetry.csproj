<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PlaxionMediator.OpenTelemetry</RootNamespace>
    <AssemblyName>PlaxionMediator.OpenTelemetry</AssemblyName>
    <PackageId>PlaxionMediator.OpenTelemetry</PackageId>
    <Description>Opt-in OpenTelemetry instrumentation (ActivitySource + Meter) for PlaxionMediator Send/Publish pipelines.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Version>0.7.0</Version>
    <PackageIcon>plaxionlogonuget.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\plaxionlogonuget.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaxionMediator.Abstractions\PlaxionMediator.Abstractions.csproj" />
    <ProjectReference Include="..\PlaxionMediator.Pipeline\PlaxionMediator.Pipeline.csproj" />
  </ItemGroup>
</Project>
