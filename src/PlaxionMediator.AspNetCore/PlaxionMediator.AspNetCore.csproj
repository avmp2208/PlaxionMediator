<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PlaxionMediator.AspNetCore</RootNamespace>
    <AssemblyName>PlaxionMediator.AspNetCore</AssemblyName>
    <PackageId>PlaxionMediator.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for PlaxionMediator, including RFC 7807 exception handling middleware.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Version>0.2.0</Version>
    <PackageIcon>plaxionlogonuget.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\plaxionlogonuget.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaxionMediator.Abstractions\PlaxionMediator.Abstractions.csproj" />
    <ProjectReference Include="..\PlaxionMediator.Core\PlaxionMediator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlaxionMediator.AspNetCore.Tests" />
  </ItemGroup>
</Project>
