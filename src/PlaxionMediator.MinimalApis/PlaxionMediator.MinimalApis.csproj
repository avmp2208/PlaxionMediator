<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PlaxionMediator.MinimalApis</RootNamespace>
    <AssemblyName>PlaxionMediator.MinimalApis</AssemblyName>
    <PackageId>PlaxionMediator.MinimalApis</PackageId>
    <Description>Minimal API endpoint mapping extensions for PlaxionMediator (MapPlaxionMediatorPost/Get/Put/Delete).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Version>0.2.0</Version>
    <PackageIcon>plaxionlogonuget.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\plaxionlogonuget.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaxionMediator.AspNetCore\PlaxionMediator.AspNetCore.csproj" />
    <ProjectReference Include="..\PlaxionMediator.Core\PlaxionMediator.Core.csproj" />
    <ProjectReference Include="..\PlaxionMediator.Abstractions\PlaxionMediator.Abstractions.csproj" />
  </ItemGroup>
</Project>
